<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <vTypeDistribution id="indian_mix">
        <!-- two-wheeler: short, quick, narrow, filters through gaps -->
        <vType id="motorcycle" probability="0.55" vClass="motorcycle"
               length="2.2" width="0.8" accel="3.5" decel="6.0" sigma="0.7"
               maxSpeed="16.6" minGap="1.0" latAlignment="arbitrary"
               lcSublane="5.0" lcPushy="0.8" lcAssertive="2.0" impatience="0.8"
               guiShape="motorcycle" color="1,0.6,0"/>
        <!-- passenger car -->
        <vType id="car" probability="0.25" vClass="passenger"
               length="4.5" width="1.8" accel="2.6" decel="4.5" sigma="0.5"
               maxSpeed="16.6" minGap="2.0" latAlignment="center"
               guiShape="passenger" color="0.4,0.6,1"/>
        <!-- auto-rickshaw: narrow, slow, assertive -->
        <vType id="auto" probability="0.13" vClass="taxi"
               length="3.2" width="1.4" accel="2.0" decel="4.0" sigma="0.6"
               maxSpeed="12.5" minGap="1.5" latAlignment="arbitrary"
               lcSublane="3.0" lcPushy="0.6" impatience="0.6"
               guiShape="passenger/hatchback" color="0.1,0.8,0.3"/>
        <!-- city bus: long, slow to clear a stop line -->
        <vType id="bus" probability="0.07" vClass="bus"
               length="12.0" width="2.5" accel="1.2" decel="3.5" sigma="0.4"
               maxSpeed="11.1" minGap="3.0" latAlignment="center"
               guiShape="bus" color="0.9,0.2,0.2"/>
    </vTypeDistribution>

    <!-- ambulance: allowed to use the emergency vClass, pushes through gaps,
         and is what the agent must learn to clear a corridor for -->
    <vType id="emergency" vClass="emergency" length="6.5" width="2.0"
           accel="2.8" decel="5.0" sigma="0.3" maxSpeed="22.2" minGap="2.0"
           speedFactor="1.3" guiShape="emergency" color="1,1,1"
           jmIgnoreFoeProb="0.3" jmIgnoreFoeSpeed="3.0"/>

    <route id="ns_left" edges="N1A1 A1B1 B1S1"/>
    <route id="ns_right" edges="N2A2 A2B2 B2S2"/>
    <route id="sn_left" edges="S1B1 B1A1 A1N1"/>
    <route id="sn_right" edges="S2B2 B2A2 A2N2"/>
    <route id="we_top" edges="W1A1 A1A2 A2E1"/>
    <route id="we_bottom" edges="W2B1 B1B2 B2E2"/>
    <route id="ew_top" edges="E1A2 A2A1 A1W1"/>
    <route id="ew_bottom" edges="E2B2 B2B1 B1W2"/>
    <route id="turn_w_to_s" edges="W1A1 A1B1 B1S1"/>
    <route id="turn_n_to_e" edges="N1A1 A1A2 A2E1"/>
    <route id="turn_e_to_s" edges="E1A2 A2B2 B2S2"/>
    <route id="turn_s_to_w" edges="S2B2 B2B1 B1W2"/>

    <flow id="f_ns_left" type="indian_mix" route="ns_left" begin="0" end="3000" vehsPerHour="500" departSpeed="max" departLane="best"/>
    <flow id="f_ns_right" type="indian_mix" route="ns_right" begin="0" end="3000" vehsPerHour="500" departSpeed="max" departLane="best"/>
    <flow id="f_sn_left" type="indian_mix" route="sn_left" begin="0" end="3000" vehsPerHour="500" departSpeed="max" departLane="best"/>
    <flow id="f_sn_right" type="indian_mix" route="sn_right" begin="0" end="3000" vehsPerHour="500" departSpeed="max" departLane="best"/>
    <flow id="f_we_top" type="indian_mix" route="we_top" begin="0" end="3000" vehsPerHour="250" departSpeed="max" departLane="best"/>
    <flow id="f_we_bottom" type="indian_mix" route="we_bottom" begin="0" end="3000" vehsPerHour="250" departSpeed="max" departLane="best"/>
    <flow id="f_ew_top" type="indian_mix" route="ew_top" begin="0" end="3000" vehsPerHour="250" departSpeed="max" departLane="best"/>
    <flow id="f_ew_bottom" type="indian_mix" route="ew_bottom" begin="0" end="3000" vehsPerHour="250" departSpeed="max" departLane="best"/>
    <flow id="f_turn_w_to_s" type="indian_mix" route="turn_w_to_s" begin="0" end="3000" vehsPerHour="100" departSpeed="max" departLane="best"/>
    <flow id="f_turn_n_to_e" type="indian_mix" route="turn_n_to_e" begin="0" end="3000" vehsPerHour="100" departSpeed="max" departLane="best"/>
    <flow id="f_turn_e_to_s" type="indian_mix" route="turn_e_to_s" begin="0" end="3000" vehsPerHour="100" departSpeed="max" departLane="best"/>
    <flow id="f_turn_s_to_w" type="indian_mix" route="turn_s_to_w" begin="0" end="3000" vehsPerHour="100" departSpeed="max" departLane="best"/>

    <vehicle id="ambulance_0" type="emergency" route="ns_left" depart="600" departSpeed="max" departLane="best"/>
    <vehicle id="ambulance_1" type="emergency" route="ns_left" depart="1200" departSpeed="max" departLane="best"/>
    <vehicle id="ambulance_2" type="emergency" route="ns_left" depart="1800" departSpeed="max" departLane="best"/>
    <vehicle id="ambulance_3" type="emergency" route="ns_left" depart="2400" departSpeed="max" departLane="best"/>
</routes>
